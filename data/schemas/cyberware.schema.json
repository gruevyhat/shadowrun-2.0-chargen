{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cyberware.schema.json",
  "title": "SR2 Cyberware",
  "type": "object",
  "required": ["cyberware"],
  "additionalProperties": false,
  "properties": {
    "cyberware": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "essenceCost", "costNuyen"],
        "additionalProperties": false,
        "properties": {
          "id":           { "type": "string" },
          "name":         { "type": "string" },
          "category":     { "type": "string", "enum": ["headware", "bodyware", "cyberweapon", "cyberlimp", "senseware"] },
          "essenceCost":  { "type": "number", "minimum": 0 },
          "costNuyen":    { "type": "integer", "minimum": 0 },
          "effect":       { "type": "string" },
          "rating":       { "type": "boolean" },
          "maxRating":    { "type": "integer" },
          "notes":        { "type": "string" }
        }
      }
    }
  }
}
