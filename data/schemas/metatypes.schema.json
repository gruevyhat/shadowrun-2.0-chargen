{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "metatypes.schema.json",
  "title": "SR2 Metatypes",
  "type": "object",
  "required": ["metatypes"],
  "additionalProperties": false,
  "properties": {
    "metatypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "isMetahuman", "attributeMods", "specialAbilities", "racialMaximums"],
        "additionalProperties": false,
        "properties": {
          "id":           { "type": "string" },
          "name":         { "type": "string" },
          "isMetahuman":  { "type": "boolean" },
          "attributeMods": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "body":        { "type": "integer" },
              "quickness":   { "type": "integer" },
              "strength":    { "type": "integer" },
              "charisma":    { "type": "integer" },
              "intelligence":{ "type": "integer" },
              "willpower":   { "type": "integer" }
            }
          },
          "specialAbilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "racialMaximums": {
            "type": "object",
            "required": ["body", "quickness", "strength", "charisma", "intelligence", "willpower"],
            "additionalProperties": false,
            "properties": {
              "body":        { "type": "integer", "minimum": 1 },
              "quickness":   { "type": "integer", "minimum": 1 },
              "strength":    { "type": "integer", "minimum": 1 },
              "charisma":    { "type": "integer", "minimum": 1 },
              "intelligence":{ "type": "integer", "minimum": 1 },
              "willpower":   { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
