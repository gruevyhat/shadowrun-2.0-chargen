{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skills.schema.json",
  "title": "SR2 Skills",
  "type": "object",
  "required": ["skills"],
  "additionalProperties": false,
  "properties": {
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "linkedAttribute"],
        "additionalProperties": false,
        "properties": {
          "id":              { "type": "string" },
          "name":            { "type": "string" },
          "category":        { "type": "string", "enum": ["combat", "physical", "technical", "magical", "social", "vehicle", "knowledge", "language", "special"] },
          "linkedAttribute": { "type": "string", "enum": ["body", "quickness", "strength", "charisma", "intelligence", "willpower", "magic", "reaction"] },
          "magicianOnly":    { "type": "boolean" },
          "concentrations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
