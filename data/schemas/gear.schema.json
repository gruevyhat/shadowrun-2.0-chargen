{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gear.schema.json",
  "title": "SR2 Gear",
  "type": "object",
  "required": ["gear"],
  "additionalProperties": false,
  "properties": {
    "gear": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "costNuyen"],
        "additionalProperties": false,
        "properties": {
          "id":          { "type": "string" },
          "name":        { "type": "string" },
          "category":    { "type": "string", "enum": ["pistol", "smg", "rifle", "shotgun", "lmg", "heavyWeapon", "meleeWeapon", "projectileWeapon", "explosive", "armor", "electronics", "communications", "vehicle", "lifestyle", "other"] },
          "costNuyen":   { "type": "integer", "minimum": 0 },
          "maxRating":   { "type": "integer", "minimum": 1 },
          "concealability": { "type": "integer" },
          "damageCode":  { "type": "string" },
          "reach":       { "type": "integer" },
          "ammoCapacity":{ "type": "integer" },
          "recoilComp":  { "type": "integer" },
          "armorBallistic": { "type": "integer" },
          "armorImpact": { "type": "integer" },
          "notes":       { "type": "string" }
        }
      }
    }
  }
}
