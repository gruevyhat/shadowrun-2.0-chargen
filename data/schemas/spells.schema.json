{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spells.schema.json",
  "title": "SR2 Spells",
  "type": "object",
  "required": ["spells"],
  "additionalProperties": false,
  "properties": {
    "spells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "type", "target", "drainCode"],
        "additionalProperties": false,
        "properties": {
          "id":        { "type": "string" },
          "name":      { "type": "string" },
          "category":  { "type": "string", "enum": ["combat", "detection", "health", "illusion", "manipulation"] },
          "type":      { "type": "string", "enum": ["mana", "physical"] },
          "target":    { "type": "string" },
          "drainCode": { "type": "string" },
          "notes":     { "type": "string" }
        }
      }
    }
  }
}
